# =========================================
# SmartComanda - Environment Variables
# Copy to .env and fill in real values.
# NEVER commit a real .env file.
# =========================================

# --- API ---
PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# --- API Docs (Swagger) ---
# Enabled by default outside production. Set to false to disable, or true to force enable.
# In production (NODE_ENV=production) docs are disabled unless explicitly set to true.
ENABLE_API_DOCS=true

# --- PostgreSQL (existing services) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=restaurant_saas

# --- Auth (JWT) ---
# Required: minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=<change-me-min-32-chars>
JWT_EXPIRES_IN=1h

# --- n8n ---
N8N_EMAIL=<change-me>
N8N_PASSWORD=<change-me>

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=<change-me>
PGADMIN_DEFAULT_PASSWORD=<change-me>
