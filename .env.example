# =========================================
# SmartComanda - Environment Variables
# Copy to .env and fill in real values.
# NEVER commit a real .env file.
# =========================================

# --- API ---
PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# --- PostgreSQL (existing services) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=restaurant_saas

# --- Auth (JWT) ---
# Required: minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=<change-me-min-32-chars>
JWT_EXPIRES_IN=1h

# --- n8n ---
N8N_EMAIL=<change-me>
N8N_PASSWORD=<change-me>

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=<change-me>
PGADMIN_DEFAULT_PASSWORD=<change-me>

# --- MongoDB ---
# Local (backend running on the host / MongoDB Compass):
MONGODB_URI=mongodb://localhost:27017/smartcomanda
# Inside the Docker network the api service overrides this with:
#   mongodb://mongodb:27017/smartcomanda
# Remote (MongoDB Atlas) - replace with real values, never commit:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# Host port exposed by the mongodb container (bound to 127.0.0.1 only)
MONGODB_PORT=27017

# Atlas backup/restore source (used ONLY by scripts, never by the app)
ATLAS_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>